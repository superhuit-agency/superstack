{
  	"editor.formatOnSave": true,
	"files.watcherExclude": {
		"**/.git/objects/**": true,
		"**/.git/subtree-cache/**": true,
		"**/node_modules/**": true,
		"wordpress/theme/static/**": true,
		"wordpress/wp-content/**": true,
		"wordpress/.data/**": true,
		"**/package-lock.json": true,
		".next/**": true,
		"**/build/**": true,
	},
	"search.exclude": {
		"**/.git/objects/**": true,
		"**/.git/subtree-cache/**": true,
		"**/node_modules/**": true,
		"wordpress/theme/static/**": true,  
		"wordpress/plugins/**": true,
		"wordpress/.data/**": true,
		"**/package-lock.json": true,
		".next/**": true,
		"**/build/**": true,
    },
    "intelephense.format.braces": "k&r",
}
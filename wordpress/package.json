{
  "name": "superstack-wp",
  "version": "1.0.0",
  "description": "starter website backend - frontend built on Next.js",
  "main": "index.js",
  "type": "module",
  "repository": "https://github.com/superhuit-agency/superstack",
  "author": "superhuit <tech@superhuit.ch>",
  "license": "MIT",
  "private": true,
  "scripts": {
    "prestart": "sh ./scripts/pre-start.sh",
    "dev": "NEXT_PUBLIC_IS_THIS_NEXT=false vite",
    "start": "sh ./scripts/start-wp.sh",
    "stop": "docker compose down",
    "logs": "docker compose logs -f",
    "build": "THEME_NAME=superstack NEXT_PUBLIC_IS_THIS_NEXT=false vite build",
    "generate:pot": "wp i18n make-pot ./theme theme/languages/supt.pot",
    "generate:json": "wp i18n make-json ./theme/languages/fr_FR.po --no-purge",
    "analyze": "ANALYZE=true THEME_NAME=superstack NEXT_PUBLIC_IS_THIS_NEXT=false vite build"
  },
  "devDependencies": {
    "@tsconfig/node20": "^20.1.2",
    "@types/wordpress__block-editor": "^11.5.0",
    "@types/wordpress__block-library": "^2.6.1",
    "@types/wordpress__blocks": "^12.5.0",
    "@types/wordpress__edit-post": "^7.0.2",
    "@types/wordpress__plugins": "^3.0.0",
    "@types/wordpress__rich-text": "^6.4.0",
    "@vitejs/plugin-react": "^6.0.1",
    "@wordpress/api-fetch": "^7.4.0",
    "@wordpress/blob": "^4.4.0",
    "@wordpress/plugins": "^7.4.0",
    "@wordpress/url": "^4.4.0",
    "postcss": "^8.4.35",
    "postcss-extend-rule": "^4.0.0",
    "postcss-gap-properties": "^5.0.1",
    "postcss-hexrgba": "^2.1.0",
    "postcss-import": "^16.0.0",
    "postcss-mixins": "^12.0.0",
    "postcss-nested": "^6.0.1",
    "postcss-normalize": "^10.0.1",
    "postcss-preset-env": "^9.3.0",
    "postcss-simple-vars": "^7.0.1",
    "rollup-plugin-visualizer": "^7.0.1",
    "typescript": "^5.0.4",
    "vite": "^8.0.8"
  }
}

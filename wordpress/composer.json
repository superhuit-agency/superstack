{
  "name": "superhuit/superstack",
  "version": "1.0.0",
  "type": "project",
  "authors": [
    {
      "name": "Superhuit",
      "email": "tech@superhuit.ch"
    }
  ],
  "config": {
    "allow-plugins": {
      "composer/installers": true
    }
  },
  "extra": {
    "installer-paths": {
      "wp-content/plugins/{$name}/": [
        "type:wordpress-plugin"
      ]
    }
  },
  "require": {
    "php": "^8.3",
    "wpackagist-plugin/disable-comments": "^2.6",
    "wpackagist-plugin/disable-emojis": "^1.7",
    "wpackagist-plugin/duplicate-post": "^4.5",
    "wpackagist-plugin/redirection": "^5.6",
    "wpackagist-plugin/simple-custom-post-order": "^2.5",
    "wpackagist-plugin/svg-support": "^2.5",
    "wpackagist-plugin/wordpress-seo": "^27.0",
    "wpengine/advanced-custom-fields-pro": "^6.7",
    "superhuit-agency/forminator": "dev-main",
    "wpackagist-plugin/content-control": "^2.6",
    "wpackagist-plugin/user-role-editor": "^4.64",
    "wpackagist-plugin/gallery-block-lightbox": "^1.16",
    "wpackagist-plugin/wp-nested-pages": "^3.2",
    "superhuit/cookie-law-consent": "^1.8",
    "ashhitch/wp-graphql-yoast-seo": "^5.0",
    "pristas-peter/wp-graphql-gutenberg": "dev-master",
    "superhuit/wp-graphql-redirection": "^1.1",
    "superhuit-agency/nextjs-revalidate": "^1.6",
    "valu/wp-graphql-offset-pagination": "^0.2.1",
    "wp-graphql/wp-graphql-jwt-authentication": "^0.7.2",
    "wpackagist-plugin/wp-graphql": "^2.11"
  },
  "repositories": [
    {
      "name": "release-belt.superhuit.ch",
      "type": "composer",
      "url": "https://release-belt.superhuit.ch/"
    },
    {
      "name": "acf",
      "type": "composer",
      "url": "https://connect.advancedcustomfields.com"
    },
    {
      "type": "package",
      "package": {
        "name": "superhuit-agency/nextjs-revalidate",
        "version": "1.6.4",
        "type": "wordpress-plugin",
        "dist": {
          "url": "https://github.com/superhuit-agency/nextjs-revalidate/releases/download/v1.6.4/nextjs-revalidate-v1.6.4.zip",
          "type": "zip"
        }
      }
    },
    {
      "type": "vcs",
      "url": "https://github.com/superhuit-agency/wp-graphql-gutenberg"
    },
    {
      "type": "package",
      "package": {
        "name": "superhuit-agency/wp-graphql-offset-pagination",
        "version": "0.2.1",
        "type": "wordpress-plugin",
        "dist": {
          "url": "https://github.com/superhuit-agency/wp-graphql-offset-pagination/releases/download/v0.2.1/wp-graphql-offset-pagination.zip",
          "type": "zip"
        }
      }
    },
    {
      "type": "composer",
      "url": "https://wpackagist.org",
      "only": [
        "wpackagist-plugin/*",
        "wpackagist-theme/*"
      ]
    },
    {
      "type": "vcs",
      "url": "https://github.com/superhuit-agency/forminator"
    }
  ]
}

# Only required if you want to override the default values.
# Copy to .env — or let scripts/setup-instance.sh generate one per instance.

## Docker
## Every container and the compose project are named after PROJECT_CODE.
## Change it if another project on your machine already uses "spck".
PROJECT_CODE=spck
THEME_NAME=superstack

## Ports exposed on the host
WP_PORT=80
DB_PORT=3306

## Instance URLs — WP_HOME/WP_SITEURL follow WORDPRESS_URL, so a database
## seeded from another instance works whatever port this one runs on.
WORDPRESS_URL=http://localhost
NEXT_URL=http://localhost:3000

## Local-only auto-login. When set, /?dev_autologin=<secret> signs you in as
## administrator (see server/mu-plugins/dev-autologin.php). Leave empty to
## disable. Generate with `openssl rand -hex 16`.
DEV_AUTOLOGIN_SECRET=

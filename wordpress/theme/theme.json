{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": false,
		"useRootPaddingAwareAlignments": false,
		"background": {
			"backgroundImage": false,
			"backgroundSize": false
		},
		"border": {
			"color": false,
			"radius": false,
			"style": false,
			"width": false
		},
		"color": {
			"background": false,
			"custom": false,
			"customDuotone": false,
			"customGradient": false,
			"defaultDuotone": false,
			"defaultGradients": false,
			"defaultPalette": false,
			"duotone": [],
			"gradients": [],
			"link": false,
			"text": false,
			"heading": false,
			"button": false,
			"caption": false,
			"palette": [
				{
					"slug": "base",
					"color": "#FFFFFF",
					"name": "Base"
				},
				{
					"slug": "contrast",
					"color": "#111111",
					"name": "Contrast"
				},
				{
					"slug": "secondary",
					"color": "#686868",
					"name": "Secondary"
				},
				{
					"slug": "accent-1",
					"color": "#FF9838",
					"name": "Accent 1"
				},
				{
					"slug": "accent-2",
					"color": "#F6DADF",
					"name": "Accent 2"
				},
				{
					"slug": "accent-3",
					"color": "#C8E7F9",
					"name": "Accent 3"
				},
				{
					"slug": "accent-4",
					"color": "#E0D2F4",
					"name": "Accent 4"
				},
				{
					"slug": "accent-5",
					"color": "#D2F4D3",
					"name": "Accent 5"
				},
				{
					"slug": "accent-6",
					"color": "#FCDBA6",
					"name": "Accent 6"
				},
				{
					"slug": "accent-7",
					"color": "#F6F2EF",
					"name": "Accent 7"
				},
				{
					"slug": "accent-8",
					"color": "rgba(17, 17, 17, 0.08)",
					"name": "Accent 8"
				},
				{
					"slug": "contrast-light",
					"color": "rgba(25, 25, 25, 0.7)",
					"name": "Contrast Light"
				}
			]
		},
		"layout": {
			"contentSize": "1340px",
			"wideSize": "100%",
			"allowEditing": true,
			"allowCustomContentAndWideSize": false
		},
		"dimensions": {
			"aspectRatio": false,
			"minHeight": false
		},
		"spacing": {
			"defaultSpacingSizes": false,
			"spacingSizes": [
				{
					"name": "Tiny",
					"size": "10px",
					"slug": "20"
				},
				{
					"name": "X-Small",
					"size": "20px",
					"slug": "30"
				},
				{
					"name": "Small",
					"size": "30px",
					"slug": "40"
				},
				{
					"name": "Regular",
					"size": "clamp(30px, 5vw, 50px)",
					"slug": "50"
				},
				{
					"name": "Large",
					"size": "clamp(50px, 7vw, 70px)",
					"slug": "70"
				},
				{
					"name": "X-Large",
					"size": "clamp(50px, 7vw, 80px)",
					"slug": "80"
				},
				{
					"name": "XX-Large",
					"size": "clamp(70px, 10vw, 100px)",
					"slug": "100"
				}
			],
			"units": ["%", "px", "em", "rem", "vh", "vw"]
		},
		"position": {
			"sticky": false
		},
		"shadow": {
			"defaultPresets": false,
			"presets": []
		},
		"typography": {
			"writingMode": false,
			"defaultFontSizes": false,
			"fluid": true,
			"fontSizes": [
				{
					"fluid": false,
					"name": "Small",
					"size": "14px",
					"slug": "small"
				},
				{
					"fluid": {
						"min": "14px",
						"max": "18px"
					},
					"name": "Medium",
					"size": "18px",
					"slug": "medium"
				},
				{
					"fluid": {
						"max": "20px",
						"min": "18px"
					},
					"name": "Large",
					"size": "20px",
					"slug": "large"
				},
				{
					"fluid": {
						"max": "28px",
						"min": "20px"
					},
					"name": "Extra Large",
					"size": "28px",
					"slug": "x-large"
				},
				{
					"fluid": {
						"max": "38px",
						"min": "27px"
					},
					"name": "Extra Extra Large",
					"size": "38px",
					"slug": "xx-large"
				},
				{
					"fluid": {
						"max": "48px",
						"min": "27px"
					},
					"name": "H1",
					"size": "48px",
					"slug": "h1"
				},
				{
					"fluid": {
						"max": "48px",
						"min": "27px"
					},
					"name": "H2",
					"size": "48px",
					"slug": "h2"
				},
				{
					"fluid": {
						"max": "48px",
						"min": "27px"
					},
					"name": "H3",
					"size": "48px",
					"slug": "h3"
				}
			],
			"customFontSize": false,
			"dropCap": false,
			"fontStyle": false,
			"fontWeight": false,
			"letterSpacing": false,
			"lineHeight": [],
			"textColumns": false,
			"textDecoration": false,
			"textTransform": false,
			"fontFamilies": [
				{
					"name": "Manrope",
					"slug": "manrope",
					"fontFamily": "Manrope, sans-serif",
					"fontFace": [
						{
							"src": [
								"file:./assets/fonts/manrope/Manrope-VariableFont_wght.woff2"
							],
							"fontWeight": "200 800",
							"fontStyle": "normal",
							"fontFamily": "Manrope"
						}
					]
				}
			]
		},
		"custom": {
			"layout": {
				"narrow": "clamp(300px, 60vw, 900px)"
			},
			"lineHeight": {
				"medium": "clamp(16px, calc(16px + (2 * (100vw - 320px) / 1020)), 18px)"
			}
		}
	},
	"styles": {
		"elements": {
			"h1": {
				"typography": {
					"fontSize": "clamp(34px, calc(34px + (14 * (100vw - 320px) / 1020)), 48px)",
					"fontWeight": "600",
					"lineHeight": "1.1",
					"letterSpacing": "-0.96px"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "clamp(28px, calc(28px + (12 * (100vw - 320px) / 1020)), 40px)",
					"fontWeight": "700",
					"lineHeight": "1.1",
					"letterSpacing": "-0.8px"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "clamp(20px, calc(20px + (8 * (100vw - 320px) / 1020)), 28px)",
					"fontWeight": "700",
					"lineHeight": "1.1",
					"letterSpacing": "-0.56px"
				}
			},
			"h4": {
				"typography": {
					"fontSize": "clamp(17px, calc(17px + (7 * (100vw - 320px) / 1020)), 24px)",
					"fontWeight": "600",
					"lineHeight": "1.1",
					"letterSpacing": "-0.48px"
				}
			},
			"h5": {
				"typography": {
					"fontSize": "clamp(14px, calc(14px + (6 * (100vw - 320px) / 1020)), 20px)",
					"fontWeight": "600",
					"lineHeight": "1.1",
					"letterSpacing": "-0.4px"
				}
			},
			"h6": {
				"typography": {
					"fontSize": "clamp(10px, calc(10px + (4 * (100vw - 320px) / 1020)), 14px)",
					"fontWeight": "800",
					"lineHeight": "1.1",
					"letterSpacing": "0.7px",
					"textTransform": "uppercase"
				}
			},
			"heading": {
				"typography": {
					"fontWeight": "400",
					"lineHeight": "1.1",
					"letterSpacing": "-0.1px"
				}
			}
		},
		"spacing": {
			"padding": {
				"left": 0,
				"right": 0
			}
		},
		"blocks": {}
	},
	"customTemplates": [],
	"patterns": [],
	"templateParts": [
		{
			"name": "header",
			"title": "Header",
			"area": "header"
		},
		{
			"name": "footer",
			"title": "Footer",
			"area": "footer"
		}
	]
}
